{
  "name": "word-hunter",
  "version": "0.1.0",
  "description": "Chrome extension where you hunt for a hidden word embedded invisibly in page text",
  "homepage": "https://github.com/VinderOrnitier/word-hunter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinderOrnitier/word-hunter.git"
  },
  "bugs": {
    "url": "https://github.com/VinderOrnitier/word-hunter/issues"
  },
  "main": "index.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "mv3",
    "preact",
    "typescript",
    "vite",
    "word-game",
    "gamification",
    "vocabulary"
  ],
  "author": "Vinder Ornitier <vinder.ornitier@gmail.com>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.8",
      "onFail": "download"
    }
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.1.40",
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.1.1",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "preact": "^10.29.1"
  }
}
